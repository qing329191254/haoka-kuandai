APP_NAME=派客邦
SECRET_KEY=xinglianyun-dev-secret-key-please-change
DATABASE_URL=mysql+pymysql://paikebang:paikebang123@127.0.0.1:3310/paikebang?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0

# 阿里云短信。密钥留空时无法发送验证码
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=湖北省觅智科技
SMS_TEMPLATE_CODE=SMS_338580206
SMS_ENDPOINT=dysmsapi.aliyuncs.com
# 小程序审核测试号。只有这些号码可用固定验证码，留空 MP_REVIEW_CODE 即关闭
MP_REVIEW_PHONES=13800001001,13600001111
MP_REVIEW_CODE=123456
PUBLIC_BASE_URL=http://127.0.0.1:8000
DEPOSIT_AMOUNT=5000
CORS_ORIGINS=*

# 支付环境：mock | sandbox | production（改完重启后端）
ALIPAY_ENV=mock
# 正式（ALIPAY_ENV=production）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# 沙箱（ALIPAY_ENV=sandbox，密钥在开放平台「沙箱」复制）
ALIPAY_SANDBOX_APP_ID=
ALIPAY_SANDBOX_PRIVATE_KEY=
ALIPAY_SANDBOX_PUBLIC_KEY=
ALIPAY_SANDBOX_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_SANDBOX_AMOUNT=0.01
# 异步通知路径（完整 URL = PUBLIC_BASE_URL + 本路径；本地需公网/穿透）
ALIPAY_NOTIFY_PATH=/api/pay/alipay/notify

# 阿里云 OSS（私有桶；填 RAM 子用户密钥，勿用主账号）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=paikebang-oss
OSS_REGION=cn-shanghai
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_PREFIX=uploads
OSS_SIGN_EXPIRES=3600
